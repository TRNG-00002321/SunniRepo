					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response has required fields\", function(){",
							"    const responseArray = pm.response.json();",
							"    ",
							"    pm.expect(responseArray).to.be.an(\"array\").that.is.not.empty;",
							"    ",
							"    const user = responseArray[0];    ",
							"    pm.expect(user).to.have.property(\"postId\");",
							"    pm.expect(user).to.have.property(\"id\");",
							"    pm.expect(user).to.have.property(\"email\");",
							"    // pm.expect(response).to.have.property(\"age\")",
							"})",
							"",
							"pm.test(\"Response has required fields\", function(){",
							"    const responseArray = pm.response.json();",
							"    ",
							"    pm.expect(responseArray).to.be.an(\"array\").that.is.not.empty;",
							"    ",
							"    const user = responseArray[0];",
							"    pm.expect(user.postId).to.equal(1);",
							"    pm.expect(user.id).to.equal(1);",
							"    pm.expect(user.email).to.equal(\"Eliseo@gardner.biz\");",
							"    // pm.expect(response).to.have.property(\"age\")",
							"})",
