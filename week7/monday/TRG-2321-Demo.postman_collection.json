	"item": [
		{
			"name": "Get All Posts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json()\r",
							"\r",
							"pm.test(\"Response is An Array\", function() {\r",
							"    pm.expect(jsonData).to.be.an(\"array\");\r",
							"});\r",
							"\r",
							"pm.test(\"Array has items\", function(){\r",
							"    pm.expect(jsonData).to.have.length.above(0)\r",
							"})\r",
							"\r",
							"pm.test(\"Array has 100 posts\", function() {\r",
							"    pm.expect(jsonData).to.have.lengthOf(100);\r",
							"})\r",
							"\r",
							"pm.test(\"Array items have correct structure\", function() {\r",
							"    const post = jsonData[0];\r",
							"    pm.expect(post).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");\r",
							"})\r",
							"\r",
							"pm.test(\"Array elements have id property\", function() {\r",
							"    jsonData.forEach( (item, index) => {\r",
							"        pm.expect(item).to.have.property(\"id\");\r",
							"    })\r",
							"})\r",
							"\r",
							"pm.test(\"array elements have unique id property\", function() {\r",
							"    const ids = jsonData.map(item => item.id);\r",
							"    pm.expect(ids).to.have.lengthOf(100);\r",
							"})\r",
							"\r",
							"pm.test(\"Array elements have id between 1 and 10\", function() {\r",
							"    jsonData.forEach( (item, index) => {\r",
							"        pm.expect(item.userId).to.be.within(1, 10);\r",
							"    })\r",
							"})\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseURL}}/posts",
					"host": [
						"{{baseURL}}"
					],
					"path": [
						"posts"
					]
				}
			},
			"response": []
		},
		{
